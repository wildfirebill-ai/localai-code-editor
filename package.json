{
  "name": "localai-code-editor",
  "version": "0.1.2",
  "private": true,
  "description": "A free, open-source, self-hosted AI code editor powered entirely by your local LLM — no cloud, no API keys, no telemetry. Features agentic AI assistant, MCP support, agent skills, LSP IntelliSense, and full git panel.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @localai/server dev",
    "dev:web": "pnpm --filter @localai/web dev",
    "dev:desktop": "pnpm --filter @localai/desktop dev",
    "docker:build": "docker build -t localai-code-editor .",
    "docker:run": "docker run -p 4801:4801 -v ${PWD}:/workspace -v localai-data:/data localai-code-editor"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  },
  "keywords": [
    "ai-code-editor",
    "local-llm",
    "ollama",
    "mcp",
    "model-context-protocol",
    "agentic-ai",
    "code-editor",
    "typescript",
    "electron",
    "monaco-editor",
    "lsp",
    "language-server-protocol",
    "git-panel",
    "offline-ai",
    "privacy-first",
    "self-hosted",
    "unraid",
    "docker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wildfirebill-ai/localai-code-editor.git"
  },
  "bugs": {
    "url": "https://github.com/wildfirebill-ai/localai-code-editor/issues"
  },
  "homepage": "https://github.com/wildfirebill-ai/localai-code-editor#readme",
  "author": {
    "name": "wildfirebill",
    "email": "wildfirebill@users.noreply.github.com",
    "url": "https://github.com/wildfirebill"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wildfirebill"
  }
}