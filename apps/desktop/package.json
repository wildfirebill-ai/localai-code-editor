{
  "name": "@localai/desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Multi-platform local-LLM code editor with MCP, agentic tools, and a full git panel",
  "homepage": "https://github.com/wildfirebill-ai/localai-code-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/wildfirebill-ai/localai-code-editor.git"
  },
  "author": {
    "name": "wildfirebill",
    "email": "wildfirebill@users.noreply.github.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && electron .",
    "start": "electron .",
    "predist": "pnpm -r build && pnpm --filter @localai/server build:bundle",
    "dist": "electron-builder -p never",
    "dist:win": "pnpm run predist && electron-builder --win -p never",
    "dist:mac": "pnpm run predist && electron-builder --mac -p never",
    "dist:linux": "pnpm run predist && electron-builder --linux -p never",
    "lint": "echo 'no linter configured yet'",
    "test": "echo 'no tests yet'"
  },
  "build": {
    "appId": "com.localai.codeeditor",
    "productName": "LocalAI Code Editor",
    "publish": null,
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../../packages/server/dist-server",
        "to": "server",
        "filter": ["index.cjs"]
      },
      {
        "from": "../../apps/web/dist",
        "to": "web",
        "filter": ["**/*"]
      },
      {
        "from": "../../packages/skills/builtin",
        "to": "skills",
        "filter": ["**/*"]
      }
    ],
    "win": { "target": ["nsis", "zip"] },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  }
}